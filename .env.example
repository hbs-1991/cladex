# Secrets ONLY (behavior goes in config.yaml)
# PostgreSQL (docker-compose starts it; the URL is derived from this password)
POSTGRES_PASSWORD=replace-me
# Only for running the process outside compose, e.g. on a dev host:
#CH_DATABASE_URL=postgresql+asyncpg://hermes:hermes@127.0.0.1:55432/hermes
TELEGRAM_BOT_TOKEN=123456:replace-me
# Generate with `claude setup-token` — uses your Claude subscription limits
# instead of pay-per-token API billing.
CLAUDE_CODE_OAUTH_TOKEN=replace-me
# Optional: enables voice notes (speech-to-text in, text-to-speech out). Without
# it, a voice message just gets a polite "voice isn't set up" reply. Kept out of
# the container env after startup, so the agent's Bash can never read it.
OPENAI_API_KEY=sk-replace-me
# Web UI only (docs/deploy.md 5a). CH_WEB_SECRET signs the session cookie —
# `openssl rand -hex 32`. Then ONE of: TUNNEL_TOKEN (Cloudflare Tunnel, the base
# compose file) or CLADEX_HOST (Caddy with Let's Encrypt, docker-compose.caddy.yml).
#CH_WEB_SECRET=
#TUNNEL_TOKEN=
#CLADEX_HOST=cladex.example.com
# Only with telegram_mode: webhook (docs/deploy.md, "Webhook mode"): the shared
# secret Telegram proves itself with, in the URL path AND in every delivery's
# X-Telegram-Bot-Api-Secret-Token header — `openssl rand -hex 32`.
#CH_TELEGRAM_WEBHOOK_SECRET=

# --- Wave 3a: queue, blobs, extension secrets ------------------------------
# CH_REDIS_URL is the ONLY switch between the two topologies. Set by
# docker-compose for the agent/worker/scheduler containers; set it here only to
# run against a Redis outside compose.
#CH_REDIS_URL=redis://127.0.0.1:6379/0
# MinIO holds uploads and agent-produced files. Both are also the S3 credentials
# the agent and worker use (CH_S3_ACCESS_KEY / CH_S3_SECRET_KEY are derived from
# them in docker-compose.yml, so they can never drift apart).
MINIO_ROOT_USER=hermes
MINIO_ROOT_PASSWORD=replace-me
# Encrypts the extension_secrets table. Without it the app can store a secret it
# can never read back, so it is required as soon as blob/extension state is used.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes every existing row undecryptable — keep the old one until the
# secrets have been re-entered.
CH_SECRETS_KEY=replace-me
